# ==============================================================================
# Travora Environment Configuration (Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Client ID (Authentication)
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:3000, http://localhost:5173
# Authorized Redirect URIs:     http://localhost:3000, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (Smart Itinerary Generation & Trip Suggestions)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Foursquare Places API (Attractions, Cafes, Restaurants & POI Discovery)
# ------------------------------------------------------------------------------
# Get your API key from Foursquare Developer Console:
# https://location.foursquare.com/developer/
VITE_FOURSQUARE_API_KEY=

# ------------------------------------------------------------------------------
# 4. Geoapify API (Geocoding, Reverse Geocoding & Address Autocomplete)
# ------------------------------------------------------------------------------
# Get your API key from Geoapify MyProjects:
# https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# ------------------------------------------------------------------------------
# 5. Supabase (Cloud Sync, Database & Collaborative Real-Time Trips)
# ------------------------------------------------------------------------------
# Optional: If not provided, Travora runs seamlessly in local storage mode
# Get these from your Supabase project settings -> API:
# https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
